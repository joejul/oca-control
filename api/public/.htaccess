<IfModule mod_rewrite.c>
    RewriteEngine On

    # Todo lo que no sea un archivo real se maneja por el front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Nunca servir el config ni fuentes directamente.
<FilesMatch "\.(php)$">
    Require all denied
</FilesMatch>
<Files "index.php">
    Require all granted
</Files>
